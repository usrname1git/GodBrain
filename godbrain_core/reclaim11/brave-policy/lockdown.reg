Windows Registry Editor Version 5.00

; Reclaim11 Brave lockdown (policy only). Install Brave from brave.com first.
; Home has no gpedit: these keys ARE the policy. HKLM if admin, HKCU always.
; Not a forked browser. Not Local State.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\BraveSoftware\Brave]
"BraveP3AEnabled"=dword:00000000
"UrlKeyedAnonymizedDataCollectionEnabled"=dword:00000000
"SafeBrowsingExtendedReportingEnabled"=dword:00000000
"MetricsReportingEnabled"=dword:00000000
"BraveRewardsDisabled"=dword:00000001
"BraveStatsPingEnabled"=dword:00000000
"BraveTalkDisabled"=dword:00000001
"BraveVPNDisabled"=dword:00000001
"BraveWalletDisabled"=dword:00000001
"TorDisabled"=dword:00000001
"BraveAIChatEnabled"=dword:00000000
"BraveNewsDisabled"=dword:00000001
"SafeBrowsingSurveysEnabled"=dword:00000000
"BraveWebDiscoveryEnabled"=dword:00000000
"BravePlaylistEnabled"=dword:00000000
"ShowHomeButton"=dword:00000000

; Shields defaults from the operator's current Brave (desk). Aggressive
; vs Standard adblock is not in ADMX; BlockAds is the GPO equivalent.
"DefaultBraveAdblockSetting"=dword:00000002
"DefaultBraveHttpsUpgradeSetting"=dword:00000003
"DefaultJavaScriptSetting"=dword:00000001
"DefaultBraveFingerprintingV2Setting"=dword:00000003
"BlockThirdPartyCookies"=dword:00000001
"DefaultCookiesSetting"=dword:00000001
"DefaultBraveRemember1PStorageSetting"=dword:00000001

[HKEY_CURRENT_USER\SOFTWARE\Policies\BraveSoftware\Brave]
"BraveP3AEnabled"=dword:00000000
"UrlKeyedAnonymizedDataCollectionEnabled"=dword:00000000
"SafeBrowsingExtendedReportingEnabled"=dword:00000000
"MetricsReportingEnabled"=dword:00000000
"BraveRewardsDisabled"=dword:00000001
"BraveStatsPingEnabled"=dword:00000000
"BraveTalkDisabled"=dword:00000001
"BraveVPNDisabled"=dword:00000001
"BraveWalletDisabled"=dword:00000001
"TorDisabled"=dword:00000001
"BraveAIChatEnabled"=dword:00000000
"BraveNewsDisabled"=dword:00000001
"SafeBrowsingSurveysEnabled"=dword:00000000
"BraveWebDiscoveryEnabled"=dword:00000000
"BravePlaylistEnabled"=dword:00000000
"ShowHomeButton"=dword:00000000
"DefaultBraveAdblockSetting"=dword:00000002
"DefaultBraveHttpsUpgradeSetting"=dword:00000003
"DefaultJavaScriptSetting"=dword:00000001
"DefaultBraveFingerprintingV2Setting"=dword:00000003
"BlockThirdPartyCookies"=dword:00000001
"DefaultCookiesSetting"=dword:00000001
"DefaultBraveRemember1PStorageSetting"=dword:00000001
