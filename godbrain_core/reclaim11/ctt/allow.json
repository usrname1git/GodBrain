{
  "id": "reclaim11-ctt-allow-v1",
  "trust": "candidate",
  "auto_verify": "never",
  "source": "https://github.com/ChrisTitusTech/winutil/blob/main/config/tweaks.json",
  "doc": "https://winutil.christitus.com/code-reference/tweaks/essential-tweaks/telemetry/",
  "allow": [
    "WPFTweaksTelemetry"
  ],
  "alias": {
    "WPFTweaksTele": "WPFTweaksTelemetry"
  },
  "never": [
    "WPFTweaksServices",
    "WPFTweaksDiskCleanup",
    "WPFTweaksDisableBitLocker",
    "WPFTweaksReservedStorage",
    "WPFTweaksDisableIPv6",
    "WPFTweaksTeredo"
  ],
  "skip_invoke": [
    "Set-MpPreference"
  ],
  "not": [
    "irm | iex",
    "winget",
    "choco",
    "DISM",
    "BFE",
    "mpssvc",
    "FltMgr",
    "EventLog"
  ]
}
