<service>
  <id>GodBrainService</id>
  <name>GodBrain Cognitive OS</name>
  <description>API Server for the GodBrain Sovereign SRE Agent powered by Colibri.</description>
  
  <!-- Environment variables to ensure Colibri uses the GPU -->
  <env name="COLI_CUDA" value="1"/>
  <env name="CUDA_EXPERT_GB" value="4"/>
  
  <!-- Executable and target script -->
  <executable>C:\Users\autismo\scoop\apps\python\current\python.exe</executable>
  <arguments>godbrain_core\api_server.py</arguments>
  
  <!-- Working directory -->
  <workingdirectory>C:\Users\autismo\Documents\GitHub\GodBrain</workingdirectory>
  
  <!-- Logging and Crash Recovery -->
  <log mode="roll"></log>
  <onfailure action="restart" delay="10 sec"/>
</service>